<?xml version="1.0" encoding="utf-8"?>
<!--
    Cube face diagram: 3×3 grid with a 180° DOUBLE-TURN arrow.
    Two opposing arcs (top and bottom) to convey a half-turn.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <!-- 3×3 grid cells -->
    <!-- Row 0 -->
    <path android:fillColor="#40FFFFFF" android:strokeColor="#FFFFFFFF" android:strokeWidth="1.2"
        android:pathData="M12,12 L32,12 32,32 12,32 Z" />
    <path android:fillColor="#40FFFFFF" android:strokeColor="#FFFFFFFF" android:strokeWidth="1.2"
        android:pathData="M38,12 L58,12 58,32 38,32 Z" />
    <path android:fillColor="#40FFFFFF" android:strokeColor="#FFFFFFFF" android:strokeWidth="1.2"
        android:pathData="M64,12 L84,12 84,32 64,32 Z" />
    <!-- Row 1 -->
    <path android:fillColor="#40FFFFFF" android:strokeColor="#FFFFFFFF" android:strokeWidth="1.2"
        android:pathData="M12,38 L32,38 32,58 12,58 Z" />
    <path android:fillColor="#80FFFFFF" android:strokeColor="#FFFFFFFF" android:strokeWidth="1.2"
        android:pathData="M38,38 L58,38 58,58 38,58 Z" />
    <path android:fillColor="#40FFFFFF" android:strokeColor="#FFFFFFFF" android:strokeWidth="1.2"
        android:pathData="M64,38 L84,38 84,58 64,58 Z" />
    <!-- Row 2 -->
    <path android:fillColor="#40FFFFFF" android:strokeColor="#FFFFFFFF" android:strokeWidth="1.2"
        android:pathData="M12,64 L32,64 32,84 12,84 Z" />
    <path android:fillColor="#40FFFFFF" android:strokeColor="#FFFFFFFF" android:strokeWidth="1.2"
        android:pathData="M38,64 L58,64 58,84 38,84 Z" />
    <path android:fillColor="#40FFFFFF" android:strokeColor="#FFFFFFFF" android:strokeWidth="1.2"
        android:pathData="M64,64 L84,64 84,84 64,84 Z" />

    <!--
        Top arc: right half-circle, going CW from left (4,48) to right (92,48)
        passing through the top.
    -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M14,48 A34,34 0 0,1 82,48" />
    <!-- Arrowhead at (82,48) pointing right -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M88,41 L88,55 L96,48 Z" />

    <!--
        Bottom arc: left half-circle, going CW from right (82,48) to left (14,48)
        passing through the bottom.
    -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M82,48 A34,34 0 0,1 14,48" />
    <!-- Arrowhead at (14,48) pointing left -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M8,41 L8,55 L0,48 Z" />

</vector>
