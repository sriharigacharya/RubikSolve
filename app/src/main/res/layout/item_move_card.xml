<?xml version="1.0" encoding="utf-8"?>
<!--
    Reusable move-card item.
    Content is populated programmatically in MoveNotationGuideHelper.
    IDs are fixed so the host can reach them via card.findViewById().
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#2E2E3A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Diagram: face grid + direction arrow -->
        <ImageView
            android:id="@+id/iv_move_diagram"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="move diagram"
            android:src="@drawable/ic_move_cw" />

        <!-- Text info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <!-- Move notation (e.g. "R", "R′", "R2") -->
            <TextView
                android:id="@+id/tv_move_notation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.01" />

            <!-- Short label, e.g. "Right — Clockwise" -->
            <TextView
                android:id="@+id/tv_move_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Right · Clockwise"
                android:textColor="@color/accent_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <!-- Full description -->
            <TextView
                android:id="@+id/tv_move_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Rotate the Right (Red) face 90° clockwise when viewed from the right side."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.35" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
