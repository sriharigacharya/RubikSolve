<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Step Counter Header -->
    <TextView
        android:id="@+id/tv_guide_step"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Step 1 of 18"
        android:textColor="@color/accent_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Progress Indicator Bar -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_solve_steps"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        app:indicatorColor="@color/accent_primary"
        app:trackColor="@color/rubik_unassigned"
        app:trackCornerRadius="3dp"
        app:layout_constraintTop_toBottomOf="@id/tv_guide_step" />

    <!-- Giant Move Instruction -->
    <TextView
        android:id="@+id/tv_guide_move"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="R'"
        android:textColor="@color/text_primary"
        android:textSize="72sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:layout_marginTop="24dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_solve_steps" />

    <!-- Move Description text -->
    <TextView
        android:id="@+id/tv_guide_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Rotate the Right face counter-clockwise 90 degrees."
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_guide_move" />

    <!-- Visual Aid Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_visual_aid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:cardBackgroundColor="@color/bg_surface"
        app:cardCornerRadius="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="#2C2C35"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/tv_guide_description"
        app:layout_constraintBottom_toTopOf="@id/tv_full_sequence_label"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <!-- Face visual showing which face to turn -->
            <TextView
                android:id="@+id/tv_visual_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Face to turn: RIGHT (Red)"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent" />

            <!-- Isometric Arrow drawing to indicate turn direction -->
            <ImageView
                android:id="@+id/img_turn_arrow"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/ic_arrow_ccw"
                app:tint="@color/accent_primary"
                app:layout_constraintTop_toBottomOf="@id/tv_visual_title"
                app:layout_constraintBottom_toTopOf="@id/tv_visual_tip"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent" />

            <TextView
                android:id="@+id/tv_visual_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hold White on Top, Green in Front"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Full Sequence Label -->
    <TextView
        android:id="@+id/tv_full_sequence_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remaining Moves"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/sv_full_sequence"
        app:layout_constraintLeft_toLeftOf="parent" />

    <!-- Full sequence horizontal scroll view -->
    <HorizontalScrollView
        android:id="@+id/sv_full_sequence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/rl_guide_controls"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <LinearLayout
            android:id="@+id/ll_full_sequence_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp">
            <!-- Dynamically populated TextViews representing the moves in sequence -->
        </LinearLayout>

    </HorizontalScrollView>

    <!-- Navigation Controls (Back, Done/Next) -->
    <RelativeLayout
        android:id="@+id/rl_guide_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_guide_prev"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_alignParentStart="true"
            android:text="Back"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_guide_next"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_alignParentEnd="true"
            android:text="Next"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_primary"
            app:cornerRadius="12dp" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
