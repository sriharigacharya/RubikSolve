<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- ── Top bar ──────────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/ll_cam_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:background="@color/bg_dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cam_back"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Scan Cube Face"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Spacer to balance back button -->
        <View android:layout_width="72dp" android:layout_height="1dp" />
    </LinearLayout>

    <!-- ── Face selector (same colored circles as manual screen) ────────────── -->
    <!-- Layout order: U(White), L(Orange), F(Green), R(Red), B(Blue), D(Yellow) -->
    <LinearLayout
        android:id="@+id/ll_cam_face_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="6"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="4dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintTop_toBottomOf="@id/ll_cam_topbar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <!-- UP face -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:padding="4dp">
            <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                android:layout_gravity="center">
                <View android:id="@+id/cam_face_circle_u"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:clickable="true" android:focusable="true" />
                <!-- Captured checkmark -->
                <TextView android:id="@+id/cam_check_u"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:text="✓" android:textColor="#FFFFFF" android:textSize="10sp"
                    android:visibility="gone" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Up" android:textColor="@color/text_secondary"
                android:textSize="8sp" android:layout_marginTop="2dp" android:gravity="center" />
        </LinearLayout>

        <!-- LEFT face -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:padding="4dp">
            <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                android:layout_gravity="center">
                <View android:id="@+id/cam_face_circle_l"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/cam_check_l"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:text="✓" android:textColor="#FFFFFF" android:textSize="10sp"
                    android:visibility="gone" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Left" android:textColor="@color/text_secondary"
                android:textSize="8sp" android:layout_marginTop="2dp" android:gravity="center" />
        </LinearLayout>

        <!-- FRONT face -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:padding="4dp">
            <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                android:layout_gravity="center">
                <View android:id="@+id/cam_face_circle_f"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/cam_check_f"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:text="✓" android:textColor="#FFFFFF" android:textSize="10sp"
                    android:visibility="gone" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Front" android:textColor="@color/text_secondary"
                android:textSize="8sp" android:layout_marginTop="2dp" android:gravity="center" />
        </LinearLayout>

        <!-- RIGHT face -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:padding="4dp">
            <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                android:layout_gravity="center">
                <View android:id="@+id/cam_face_circle_r"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/cam_check_r"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:text="✓" android:textColor="#FFFFFF" android:textSize="10sp"
                    android:visibility="gone" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Right" android:textColor="@color/text_secondary"
                android:textSize="8sp" android:layout_marginTop="2dp" android:gravity="center" />
        </LinearLayout>

        <!-- BACK face -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:padding="4dp">
            <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                android:layout_gravity="center">
                <View android:id="@+id/cam_face_circle_b"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/cam_check_b"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:text="✓" android:textColor="#FFFFFF" android:textSize="10sp"
                    android:visibility="gone" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Back" android:textColor="@color/text_secondary"
                android:textSize="8sp" android:layout_marginTop="2dp" android:gravity="center" />
        </LinearLayout>

        <!-- DOWN face -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:padding="4dp">
            <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                android:layout_gravity="center">
                <View android:id="@+id/cam_face_circle_d"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/cam_check_d"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:text="✓" android:textColor="#FFFFFF" android:textSize="10sp"
                    android:visibility="gone" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Down" android:textColor="@color/text_secondary"
                android:textSize="8sp" android:layout_marginTop="2dp" android:gravity="center" />
        </LinearLayout>

    </LinearLayout>

    <!-- Current face label -->
    <TextView
        android:id="@+id/tv_cam_face_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="FRONT FACE (Green Center)"
        android:textColor="@color/accent_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/ll_cam_face_selector"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <TextView
        android:id="@+id/tv_cam_face_orientation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Top: White • Right: Red"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/tv_cam_face_name"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- ── Camera preview + overlay ─────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/fl_camera_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/tv_cam_face_orientation"
        app:layout_constraintBottom_toTopOf="@id/card_detected_preview"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp">

        <!-- Live camera feed -->
        <androidx.camera.view.PreviewView
            android:id="@+id/preview_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />

        <!-- Overlay drawn on top: vignette + grid + dots -->
        <com.example.rubikssolve.camera.ScanOverlayView
            android:id="@+id/scan_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- ── Detected colors mini-preview ─────────────────────────────────────── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_detected_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:cardBackgroundColor="@color/bg_surface"
        app:cardCornerRadius="14dp"
        app:strokeWidth="1dp"
        app:strokeColor="#2E2E3A"
        app:layout_constraintBottom_toTopOf="@id/ll_cam_actions"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detected:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginEnd="12dp" />

            <!-- 3×3 mini grid showing detected colors -->
            <GridLayout
                android:id="@+id/grid_detected_colors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="3">

                <!-- Cells populated programmatically with colored Views -->
                <View android:id="@+id/det_cell_0" android:layout_width="28dp" android:layout_height="28dp" android:layout_margin="2dp" android:background="@color/rubik_unassigned" />
                <View android:id="@+id/det_cell_1" android:layout_width="28dp" android:layout_height="28dp" android:layout_margin="2dp" android:background="@color/rubik_unassigned" />
                <View android:id="@+id/det_cell_2" android:layout_width="28dp" android:layout_height="28dp" android:layout_margin="2dp" android:background="@color/rubik_unassigned" />
                <View android:id="@+id/det_cell_3" android:layout_width="28dp" android:layout_height="28dp" android:layout_margin="2dp" android:background="@color/rubik_unassigned" />
                <View android:id="@+id/det_cell_4" android:layout_width="28dp" android:layout_height="28dp" android:layout_margin="2dp" android:background="@color/rubik_unassigned" />
                <View android:id="@+id/det_cell_5" android:layout_width="28dp" android:layout_height="28dp" android:layout_margin="2dp" android:background="@color/rubik_unassigned" />
                <View android:id="@+id/det_cell_6" android:layout_width="28dp" android:layout_height="28dp" android:layout_margin="2dp" android:background="@color/rubik_unassigned" />
                <View android:id="@+id/det_cell_7" android:layout_width="28dp" android:layout_height="28dp" android:layout_margin="2dp" android:background="@color/rubik_unassigned" />
                <View android:id="@+id/det_cell_8" android:layout_width="28dp" android:layout_height="28dp" android:layout_margin="2dp" android:background="@color/rubik_unassigned" />
            </GridLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Point camera at\none face of the cube"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.3"
                android:gravity="end"
                android:layout_marginStart="12dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ── Action buttons ────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/ll_cam_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <!-- Capture current face -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_capture_face"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Capture This Face"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_primary"
            app:cornerRadius="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <!-- Done button — visible once ≥1 face captured -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cam_done"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Done — Review &amp; Solve"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
